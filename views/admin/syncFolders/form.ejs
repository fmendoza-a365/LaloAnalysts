<!-- Header -->
<div class="bg-white border-b border-gray-200 mb-6">
  <div class="px-6 py-5">
    <h1 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-1">
      <%= isEdit ? 'Editar' : 'Nueva' %> Carpeta Sincronizada
    </h1>
    <p class="text-sm text-gray-600">
      Configura una carpeta de Google Drive o SharePoint para sincronización automática de datasets
    </p>
  </div>
</div>

<form method="POST" action="<%= isEdit ? '/admin/sync-folders/' + folder._id : '/admin/sync-folders' %>" class="max-w-4xl">

  <!-- Información Básica -->
  <div class="bg-white shadow rounded-lg overflow-hidden mb-6">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
      <h3 class="text-lg font-semibold text-gray-900">Información Básica</h3>
    </div>

    <div class="px-6 py-5 space-y-4">
      <!-- Nombre -->
      <div>
        <label for="nombre" class="block text-sm font-medium text-gray-700 mb-1">
          Nombre de la carpeta <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="nombre"
          name="nombre"
          required
          value="<%= isEdit ? folder.nombre : '' %>"
          placeholder="ej: Datasets Mensuales"
          class="block w-full border border-gray-300 rounded-md shadow-sm px-3 py-2 focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-sm"
        >
        <p class="mt-1 text-xs text-gray-500">Nombre descriptivo para identificar esta carpeta</p>
      </div>

      <!-- Tipo -->
      <div>
        <label for="tipo" class="block text-sm font-medium text-gray-700 mb-1">
          Tipo de almacenamiento <span class="text-red-500">*</span>
        </label>
        <select
          id="tipo"
          name="tipo"
          required
          onchange="cambiarTipo(this.value)"
          class="block w-full border border-gray-300 rounded-md shadow-sm px-3 py-2 focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-sm"
        >
          <option value="">Seleccionar...</option>
          <option value="google-drive" <%= isEdit && folder.tipo === 'google-drive' ? 'selected' : '' %>>Google Drive</option>
          <option value="sharepoint" <%= isEdit && folder.tipo === 'sharepoint' ? 'selected' : '' %>>SharePoint</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Configuración de Google Drive -->
  <div id="config-google-drive" class="bg-white shadow rounded-lg overflow-hidden mb-6" style="display: <%= isEdit && folder.tipo === 'google-drive' ? 'block' : 'none' %>">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
      <h3 class="text-lg font-semibold text-gray-900">Configuración de Google Drive</h3>
    </div>

    <div class="px-6 py-5 space-y-4">
      <!-- Folder ID -->
      <div>
        <label for="folderId" class="block text-sm font-medium text-gray-700 mb-1">
          ID de la carpeta <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="folderId"
          name="config.folderId"
          value="<%= isEdit && folder.config ? folder.config.folderId : '' %>"
          placeholder="1ABC-defGHI_jklMNO"
          class="block w-full border border-gray-300 rounded-md shadow-sm px-3 py-2 focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-sm font-mono"
        >
        <p class="mt-1 text-xs text-gray-500">
          El ID se encuentra en la URL de Google Drive:
          <code class="bg-gray-100 px-1 py-0.5 rounded">https://drive.google.com/drive/folders/<strong>ID_AQUI</strong></code>
        </p>
      </div>

      <!-- Access Token -->
      <div>
        <label for="accessToken" class="block text-sm font-medium text-gray-700 mb-1">
          Access Token
        </label>
        <input
          type="password"
          id="accessToken"
          name="config.accessToken"
          value="<%= isEdit && folder.config && folder.config.accessToken ? '••••••••' : '' %>"
          placeholder="Dejar vacío para usar OAuth"
          class="block w-full border border-gray-300 rounded-md shadow-sm px-3 py-2 focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-sm font-mono"
        >
        <p class="mt-1 text-xs text-gray-500">
          Opcional. Si no se proporciona, se usará OAuth para autenticar.
        </p>
      </div>

      <!-- Botón OAuth -->
      <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
        <div class="flex items-start">
          <svg class="h-5 w-5 text-blue-600 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
          </svg>
          <div class="flex-1">
            <h4 class="text-sm font-medium text-blue-900">Autenticación recomendada</h4>
            <p class="mt-1 text-sm text-blue-700">
              Se recomienda usar OAuth para mayor seguridad. Los tokens se renovarán automáticamente.
            </p>
            <button type="button" onclick="iniciarOAuthGoogle()" class="mt-3 inline-flex items-center px-3 py-1.5 border border-blue-300 text-sm font-medium rounded text-blue-700 bg-white hover:bg-blue-50">
              <svg class="h-4 w-4 mr-1.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
              </svg>
              Conectar con Google
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Configuración de SharePoint -->
  <div id="config-sharepoint" class="bg-white shadow rounded-lg overflow-hidden mb-6" style="display: <%= isEdit && folder.tipo === 'sharepoint' ? 'block' : 'none' %>">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
      <h3 class="text-lg font-semibold text-gray-900">Configuración de SharePoint</h3>
    </div>

    <div class="px-6 py-5 space-y-4">
      <!-- Site URL -->
      <div>
        <label for="siteUrl" class="block text-sm font-medium text-gray-700 mb-1">
          URL del sitio <span class="text-red-500">*</span>
        </label>
        <input
          type="url"
          id="siteUrl"
          name="config.siteUrl"
          value="<%= isEdit && folder.config ? folder.config.siteUrl : '' %>"
          placeholder="https://tuempresa.sharepoint.com/sites/TuSitio"
          class="block w-full border border-gray-300 rounded-md shadow-sm px-3 py-2 focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-sm font-mono"
        >
      </div>

      <!-- Library Name -->
      <div>
        <label for="libraryName" class="block text-sm font-medium text-gray-700 mb-1">
          Nombre de la biblioteca <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="libraryName"
          name="config.libraryName"
          value="<%= isEdit && folder.config ? folder.config.libraryName : '' %>"
          placeholder="Shared Documents"
          class="block w-full border border-gray-300 rounded-md shadow-sm px-3 py-2 focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-sm"
        >
      </div>

      <!-- Folder Path -->
      <div>
        <label for="folderPath" class="block text-sm font-medium text-gray-700 mb-1">
          Ruta de la carpeta
        </label>
        <input
          type="text"
          id="folderPath"
          name="config.folderPath"
          value="<%= isEdit && folder.config ? folder.config.folderPath : '' %>"
          placeholder="Datasets (opcional, raíz por defecto)"
          class="block w-full border border-gray-300 rounded-md shadow-sm px-3 py-2 focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-sm"
        >
        <p class="mt-1 text-xs text-gray-500">
          Ruta relativa dentro de la biblioteca. Dejar vacío para usar la raíz.
        </p>
      </div>

      <!-- Access Token -->
      <div>
        <label for="spAccessToken" class="block text-sm font-medium text-gray-700 mb-1">
          Access Token
        </label>
        <input
          type="password"
          id="spAccessToken"
          name="config.accessToken"
          value="<%= isEdit && folder.config && folder.config.accessToken ? '••••••••' : '' %>"
          placeholder="Dejar vacío para usar OAuth"
          class="block w-full border border-gray-300 rounded-md shadow-sm px-3 py-2 focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-sm font-mono"
        >
      </div>

      <!-- Botón OAuth SharePoint -->
      <div class="bg-purple-50 border border-purple-200 rounded-lg p-4">
        <div class="flex items-start">
          <svg class="h-5 w-5 text-purple-600 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
          </svg>
          <div class="flex-1">
            <h4 class="text-sm font-medium text-purple-900">Autenticación de Microsoft</h4>
            <p class="mt-1 text-sm text-purple-700">
              Usa OAuth de Microsoft para acceso seguro a SharePoint.
            </p>
            <button type="button" onclick="iniciarOAuthSharePoint()" class="mt-3 inline-flex items-center px-3 py-1.5 border border-purple-300 text-sm font-medium rounded text-purple-700 bg-white hover:bg-purple-50">
              <svg class="h-4 w-4 mr-1.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.625 0h-17.25C1.507 0 0 1.507 0 3.375v17.25C0 22.493 1.507 24 3.375 24h17.25C22.493 24 24 22.493 24 20.625V3.375C24 1.507 22.493 0 20.625 0z"/>
              </svg>
              Conectar con Microsoft
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Configuración de Sincronización -->
  <div class="bg-white shadow rounded-lg overflow-hidden mb-6">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
      <h3 class="text-lg font-semibold text-gray-900">Configuración de Sincronización</h3>
    </div>

    <div class="px-6 py-5 space-y-4">
      <!-- Auto Sync -->
      <div class="flex items-start">
        <div class="flex items-center h-5">
          <input
            type="checkbox"
            id="autoSync"
            name="syncConfig.autoSync"
            value="true"
            <%= isEdit && folder.syncConfig && folder.syncConfig.autoSync ? 'checked' : '' %>
            class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
          >
        </div>
        <div class="ml-3">
          <label for="autoSync" class="text-sm font-medium text-gray-700">
            Sincronización automática
          </label>
          <p class="text-xs text-gray-500">
            Sincronizar archivos automáticamente según la frecuencia configurada
          </p>
        </div>
      </div>

      <!-- Frecuencia -->
      <div>
        <label for="frequencyMinutes" class="block text-sm font-medium text-gray-700 mb-1">
          Frecuencia de sincronización (minutos)
        </label>
        <input
          type="number"
          id="frequencyMinutes"
          name="syncConfig.frequencyMinutes"
          min="5"
          max="1440"
          value="<%= isEdit && folder.syncConfig ? folder.syncConfig.frequencyMinutes || 30 : 30 %>"
          class="block w-full md:w-48 border border-gray-300 rounded-md shadow-sm px-3 py-2 focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-sm"
        >
        <p class="mt-1 text-xs text-gray-500">
          Cada cuántos minutos revisar la carpeta (mínimo 5, máximo 1440)
        </p>
      </div>

      <!-- Auto Detect -->
      <div>
        <div class="flex items-start">
          <div class="flex items-center h-5">
            <input
              type="checkbox"
              id="autoDetect"
              name="syncConfig.autoDetect"
              value="true"
              <%= isEdit && folder.syncConfig && folder.syncConfig.autoDetect ? 'checked' : 'checked' %>
              onchange="toggleTipoFijo(this.checked)"
              class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
            >
          </div>
          <div class="ml-3">
            <label for="autoDetect" class="text-sm font-medium text-gray-700">
              Detección automática de tipo
            </label>
            <p class="text-xs text-gray-500">
              Analizar las cabeceras del archivo para determinar su tipo automáticamente
            </p>
          </div>
        </div>
      </div>

      <!-- Tipo Fijo -->
      <div id="fixedTypeContainer" style="display: <%= isEdit && folder.syncConfig && !folder.syncConfig.autoDetect ? 'block' : 'none' %>">
        <label for="fixedType" class="block text-sm font-medium text-gray-700 mb-1">
          Tipo fijo de dataset
        </label>
        <select
          id="fixedType"
          name="syncConfig.fixedType"
          class="block w-full border border-gray-300 rounded-md shadow-sm px-3 py-2 focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-sm"
        >
          <option value="">Seleccionar tipo...</option>
          <option value="genesys-rendimiento" <%= isEdit && folder.syncConfig && folder.syncConfig.fixedType === 'genesys-rendimiento' ? 'selected' : '' %>>Genesys - Rendimiento</option>
          <option value="genesys-estados" <%= isEdit && folder.syncConfig && folder.syncConfig.fixedType === 'genesys-estados' ? 'selected' : '' %>>Genesys - Estados</option>
          <option value="genesys-provision-agregada" <%= isEdit && folder.syncConfig && folder.syncConfig.fixedType === 'genesys-provision-agregada' ? 'selected' : '' %>>Genesys - Provisión Agregada</option>
          <option value="asistencia" <%= isEdit && folder.syncConfig && folder.syncConfig.fixedType === 'asistencia' ? 'selected' : '' %>>Asistencia</option>
          <option value="nomina" <%= isEdit && folder.syncConfig && folder.syncConfig.fixedType === 'nomina' ? 'selected' : '' %>>Nómina</option>
          <option value="tarifas" <%= isEdit && folder.syncConfig && folder.syncConfig.fixedType === 'tarifas' ? 'selected' : '' %>>Tarifas</option>
          <option value="asesores" <%= isEdit && folder.syncConfig && folder.syncConfig.fixedType === 'asesores' ? 'selected' : '' %>>Asesores</option>
        </select>
        <p class="mt-1 text-xs text-gray-500">
          Tipo a usar si la detección automática está desactivada
        </p>
      </div>

      <!-- Process Only New -->
      <div class="flex items-start">
        <div class="flex items-center h-5">
          <input
            type="checkbox"
            id="processOnlyNew"
            name="syncConfig.processOnlyNew"
            value="true"
            <%= isEdit && folder.syncConfig && folder.syncConfig.processOnlyNew ? 'checked' : 'checked' %>
            class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
          >
        </div>
        <div class="ml-3">
          <label for="processOnlyNew" class="text-sm font-medium text-gray-700">
            Procesar solo archivos nuevos
          </label>
          <p class="text-xs text-gray-500">
            No reprocesar archivos que ya fueron importados anteriormente
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Procesamiento de Archivos -->
  <div class="bg-white shadow rounded-lg overflow-hidden mb-6">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
      <h3 class="text-lg font-semibold text-gray-900">Procesamiento de Archivos</h3>
    </div>

    <div class="px-6 py-5 space-y-4">
      <!-- Acción después de procesar -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">
          Después de procesar el archivo
        </label>
        <div class="space-y-2">
          <div class="flex items-start">
            <div class="flex items-center h-5">
              <input
                type="radio"
                id="actionKeep"
                name="fileAction"
                value="keep"
                <%= !isEdit || (folder.syncConfig && !folder.syncConfig.deleteAfterProcess && !folder.syncConfig.moveAfterProcess) ? 'checked' : '' %>
                class="border-gray-300 text-blue-600 focus:ring-blue-500"
              >
            </div>
            <div class="ml-3">
              <label for="actionKeep" class="text-sm text-gray-700">
                Mantener en la carpeta
              </label>
            </div>
          </div>

          <div class="flex items-start">
            <div class="flex items-center h-5">
              <input
                type="radio"
                id="actionMove"
                name="fileAction"
                value="move"
                <%= isEdit && folder.syncConfig && folder.syncConfig.moveAfterProcess ? 'checked' : '' %>
                onchange="toggleMoveDestination(this.checked)"
                class="border-gray-300 text-blue-600 focus:ring-blue-500"
              >
            </div>
            <div class="ml-3">
              <label for="actionMove" class="text-sm text-gray-700">
                Mover a otra carpeta
              </label>
            </div>
          </div>

          <div class="flex items-start">
            <div class="flex items-center h-5">
              <input
                type="radio"
                id="actionDelete"
                name="fileAction"
                value="delete"
                <%= isEdit && folder.syncConfig && folder.syncConfig.deleteAfterProcess ? 'checked' : '' %>
                class="border-gray-300 text-red-600 focus:ring-red-500"
              >
            </div>
            <div class="ml-3">
              <label for="actionDelete" class="text-sm text-red-700">
                Eliminar permanentemente
              </label>
              <p class="text-xs text-red-500">
                ⚠️ No recomendado. El archivo se eliminará y no podrá recuperarse.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Carpeta destino (si es mover) -->
      <div id="moveDestinationContainer" style="display: <%= isEdit && folder.syncConfig && folder.syncConfig.moveAfterProcess ? 'block' : 'none' %>">
        <label for="moveDestinationId" class="block text-sm font-medium text-gray-700 mb-1">
          ID de carpeta destino
        </label>
        <input
          type="text"
          id="moveDestinationId"
          name="syncConfig.moveDestinationId"
          value="<%= isEdit && folder.syncConfig ? folder.syncConfig.moveDestinationId || '' : '' %>"
          placeholder="ID de carpeta para archivos procesados"
          class="block w-full border border-gray-300 rounded-md shadow-sm px-3 py-2 focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-sm font-mono"
        >
        <p class="mt-1 text-xs text-gray-500">
          Carpeta donde se moverán los archivos después de procesarlos
        </p>
      </div>
    </div>
  </div>

  <!-- Filtros Opcionales -->
  <div class="bg-white shadow rounded-lg overflow-hidden mb-6">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
      <h3 class="text-lg font-semibold text-gray-900">Filtros Opcionales</h3>
    </div>

    <div class="px-6 py-5 space-y-4">
      <!-- Extensiones permitidas -->
      <div>
        <label for="allowedExtensions" class="block text-sm font-medium text-gray-700 mb-1">
          Extensiones permitidas
        </label>
        <input
          type="text"
          id="allowedExtensions"
          name="filters.allowedExtensions"
          value="<%= isEdit && folder.filters ? folder.filters.allowedExtensions || 'xlsx,xls,csv' : 'xlsx,xls,csv' %>"
          placeholder="xlsx,xls,csv"
          class="block w-full border border-gray-300 rounded-md shadow-sm px-3 py-2 focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-sm"
        >
        <p class="mt-1 text-xs text-gray-500">
          Extensiones separadas por comas. Dejar vacío para permitir todas.
        </p>
      </div>

      <!-- Patrón de nombre -->
      <div>
        <label for="filenamePattern" class="block text-sm font-medium text-gray-700 mb-1">
          Patrón de nombre (Regex)
        </label>
        <input
          type="text"
          id="filenamePattern"
          name="filters.filenamePattern"
          value="<%= isEdit && folder.filters ? folder.filters.filenamePattern || '' : '' %>"
          placeholder="^Dataset_.*\.xlsx$ (opcional)"
          class="block w-full border border-gray-300 rounded-md shadow-sm px-3 py-2 focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-sm font-mono"
        >
        <p class="mt-1 text-xs text-gray-500">
          Expresión regular para filtrar archivos por nombre
        </p>
      </div>

      <!-- Tamaño máximo -->
      <div>
        <label for="maxSizeMB" class="block text-sm font-medium text-gray-700 mb-1">
          Tamaño máximo (MB)
        </label>
        <input
          type="number"
          id="maxSizeMB"
          name="filters.maxSizeMB"
          min="1"
          max="100"
          value="<%= isEdit && folder.filters ? folder.filters.maxSizeMB || 25 : 25 %>"
          class="block w-full md:w-48 border border-gray-300 rounded-md shadow-sm px-3 py-2 focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-sm"
        >
        <p class="mt-1 text-xs text-gray-500">
          Archivos más grandes serán ignorados
        </p>
      </div>
    </div>
  </div>

  <!-- Botones de Acción -->
  <div class="flex items-center justify-between">
    <a href="/admin/sync-folders" class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
      Cancelar
    </a>
    <button type="submit" class="inline-flex items-center px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-md shadow-sm transition-colors">
      <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      <%= isEdit ? 'Guardar Cambios' : 'Crear Carpeta' %>
    </button>
  </div>
</form>

<script>
function cambiarTipo(tipo) {
  document.getElementById('config-google-drive').style.display = tipo === 'google-drive' ? 'block' : 'none';
  document.getElementById('config-sharepoint').style.display = tipo === 'sharepoint' ? 'block' : 'none';
}

function toggleTipoFijo(autoDetect) {
  document.getElementById('fixedTypeContainer').style.display = autoDetect ? 'none' : 'block';
}

function toggleMoveDestination(isMove) {
  document.getElementById('moveDestinationContainer').style.display = isMove ? 'block' : 'none';
}

// Actualizar valores hidden según radio buttons
document.querySelectorAll('input[name="fileAction"]').forEach(radio => {
  radio.addEventListener('change', function() {
    // Crear campos hidden para enviar al servidor
    let deleteInput = document.querySelector('input[name="syncConfig.deleteAfterProcess"]');
    let moveInput = document.querySelector('input[name="syncConfig.moveAfterProcess"]');

    // Limpiar inputs existentes
    if (deleteInput) deleteInput.remove();
    if (moveInput) moveInput.remove();

    // Crear nuevos según selección
    const form = this.closest('form');
    if (this.value === 'delete') {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'syncConfig.deleteAfterProcess';
      input.value = 'true';
      form.appendChild(input);
    } else if (this.value === 'move') {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'syncConfig.moveAfterProcess';
      input.value = 'true';
      form.appendChild(input);
      toggleMoveDestination(true);
    } else {
      toggleMoveDestination(false);
    }
  });
});

