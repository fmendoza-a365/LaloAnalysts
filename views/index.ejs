<section class="theme-a365-light relative">
  <div class="absolute inset-0" style="background-image: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-accent) 100%);"></div>
  <div class="relative">
    <div class="max-w-[88%] mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28">
      <div class="grid md:grid-cols-12 gap-10 items-center">
        <div class="md:col-span-7 text-white">
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight">
            A365 · Experiencia y Analítica para decisión
          </h1>
          <p class="mt-4 text-lg max-w-2xl opacity-90">
            Transformamos operaciones con KPIs gobernados, visualizaciones consistentes e integración nativa con Power BI. Multi‑tenant por campañas, trazabilidad PxQ y acceso por roles.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <% if (!user) { %>
              <a href="/auth/register" class="inline-flex items-center px-6 py-3 rounded-lg text-white font-semibold" style="background-color: var(--brand-accent)">
                Comenzar
              </a>
              <a href="/auth/login" class="inline-flex items-center px-6 py-3 rounded-lg font-semibold" style="background-color: var(--text-on-primary); color: var(--brand-primary)">
                Iniciar sesión
              </a>
            <% } else { %>
              <a href="/dashboard" class="inline-flex items-center px-6 py-3 rounded-lg text-white font-semibold" style="background-color: var(--brand-accent)">
                Ir al Tablero
              </a>
              <a href="/powerbi" class="inline-flex items-center px-6 py-3 rounded-lg font-semibold" style="background-color: var(--text-on-primary); color: var(--brand-primary)">
                Explorar Dashbords
              </a>
            <% } %>
          </div>
        </div>
        <div class="md:col-span-5">
          <div class="bg-white rounded-2xl shadow-lg p-6 sm:p-8 border" style="border-color: var(--border)">
            <div class="grid grid-cols-2 gap-6 text-center">
              <div>
                <div class="text-3xl font-extrabold" style="color: var(--brand-primary)">+50</div>
                <div class="text-sm" style="color: var(--text-body)">KPIs gobernados</div>
              </div>
              <div>
                <div class="text-3xl font-extrabold" style="color: var(--brand-primary)">+10</div>
                <div class="text-sm" style="color: var(--text-body)">Dashbords por rol</div>
              </div>
              <div>
                <div class="text-3xl font-extrabold" style="color: var(--brand-primary)">Multi</div>
                <div class="text-sm" style="color: var(--text-body)">Campañas</div>
              </div>
              <div>
                <div class="text-3xl font-extrabold" style="color: var(--brand-primary)">PxQ</div>
                <div class="text-sm" style="color: var(--text-body)">Trazabilidad</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Features -->
<section class="theme-a365-light py-16 bg-gray-50">
  <div class="max-w-[88%] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="lg:text-center">
      <h2 class="text-sm font-semibold tracking-wide uppercase" style="color: var(--brand-primary)">Soluciones</h2>
      <p class="mt-2 text-3xl leading-8 font-extrabold tracking-tight sm:text-4xl" style="color: var(--text-title)">
        Resultados medibles con datos gobernados
      </p>
      <p class="mt-4 max-w-2xl text-xl lg:mx-auto" style="color: var(--text-body)">
        Consultoría, Inteligencia de Datos, Experiencia del Empleado y Excelencia Operativa para acelerar decisiones.
      </p>
    </div>

    <div class="mt-10">
          <div class="space-y-10 md:space-y-0 md:grid md:grid-cols-2 md:gap-x-8 md:gap-y-10">
        <div class="relative">
          <div class="absolute flex items-center justify-center h-12 w-12 rounded-md text-white" style="background-color: var(--brand-accent)">
            <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10"/></svg>
          </div>
          <div class="ml-16">
            <h3 class="text-lg leading-6 font-medium" style="color: var(--text-title)">Consultoría</h3>
            <p class="mt-2 text-base" style="color: var(--text-body)">Definiciones únicas de KPIs, gobierno y trazabilidad de extremo a extremo.</p>
          </div>
        </div>

        <div class="relative">
          <div class="absolute flex items-center justify-center h-12 w-12 rounded-md text-white" style="background-color: var(--brand-accent)">
            <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6"/></svg>
          </div>
          <div class="ml-16">
            <h3 class="text-lg leading-6 font-medium" style="color: var(--text-title)">IA y Analítica</h3>
            <p class="mt-2 text-base" style="color: var(--text-body)">Insights accionables y dashboards por rol con accesos controlados.</p>
          </div>
        </div>

        <div class="relative">
          <div class="absolute flex items-center justify-center h-12 w-12 rounded-md text-white" style="background-color: var(--brand-accent)">
            <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6"/></svg>
          </div>
          <div class="ml-16">
            <h3 class="text-lg leading-6 font-medium" style="color: var(--text-title)">Experiencia del Empleado</h3>
            <p class="mt-2 text-base" style="color: var(--text-body)">Claridad en objetivos y próximos pasos; metas vs logro con seguimiento.</p>
          </div>
        </div>

        <div class="relative">
          <div class="absolute flex items-center justify-center h-12 w-12 rounded-md text-white" style="background-color: var(--brand-accent)">
            <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7"/></svg>
          </div>
          <div class="ml-16">
            <h3 class="text-lg leading-6 font-medium" style="color: var(--text-title)">Excelencia Operativa</h3>
            <p class="mt-2 text-base" style="color: var(--text-body)">Niveles de servicio, productividad y adherencia con KPIs gobernados.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- CTA Section -->
<div style="background-color: var(--brand-primary)">
  <div class="max-w-2xl mx-auto text-center py-16 px-4 sm:py-20 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-extrabold text-white sm:text-4xl">
      <span class="block">¿Listo para comenzar?</span>
      <span class="block">Explora Dashbords y KPIs alineados a A365.</span>
    </h2>
    <p class="mt-4 text-lg leading-6 text-blue-200">
      KPIs gobernados, finanzas PxQ y visualizaciones consistentes para tus decisiones.
    </p>
    <% if (!user) { %>
      <a href="/auth/register" class="mt-8 w-full inline-flex items-center justify-center px-5 py-3 border border-transparent text-base font-medium rounded-md text-blue-600 bg-white hover:bg-blue-50 sm:w-auto">Regístrate</a>
    <% } else { %>
      <a href="/powerbi" class="mt-8 w-full inline-flex items-center justify-center px-5 py-3 border border-transparent text-base font-medium rounded-md text-blue-600 bg-white hover:bg-blue-50 sm:w-auto">Explorar Dashbords</a>
    <% } %>
  </div>
</div>
