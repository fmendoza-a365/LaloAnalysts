<div class="theme-a365-light min-h-screen grid lg:grid-cols-2 bg-gray-50">
  <div class="hidden lg:block relative">
    <div class="absolute inset-0" style="background-image: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-accent) 100%);"></div>
    <div class="absolute inset-0" style="background-color: var(--overlay-scrim);"></div>
    <div class="relative h-full flex items-center justify-center p-10">
      <div class="max-w-lg text-center text-white">
        <img src="/images/logo.png" alt="A365 Analytics" class="mx-auto mb-8 h-16 w-auto object-contain filter invert brightness-0" />
        <h2 class="text-3xl font-bold tracking-tight">Bienvenido a A365 Analytics</h2>
        <p class="mt-4 text-sm opacity-90">Gestiona accesos, visualiza dashboards y mantén el control de tus campañas con un diseño sobrio y profesional.</p>
      </div>
    </div>
  </div>
  <div class="flex items-center justify-center py-12 px-6 sm:px-8">
    <div class="w-full max-w-md bg-white rounded-xl shadow border border-gray-200 p-8">
      <div class="mb-6">
        <h1 class="text-2xl font-semibold" style="color: var(--text-title)">Inicia sesión</h1>
        <p class="mt-2 text-sm" style="color: var(--text-body)">¿No tienes cuenta? <a href="/auth/register" class="font-semibold" style="color: var(--brand-accent)">Regístrate</a></p>
      </div>
      <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">
          <ul class="list-disc pl-5 text-sm">
            <% errors.forEach(function(error) { %>
              <li><%= error.msg %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded text-sm"><%= error %></div>
      <% } %>
      <form action="/auth/login" method="POST" class="space-y-6">
        <div class="space-y-4">
          <div>
          <label for="username" class="block text-sm font-medium" style="color: var(--text-body)">Usuario</label>
            <input id="username" name="username" type="text" required value="<%= typeof username !== 'undefined' ? username : '' %>" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Tu usuario" />
          </div>
          <div>
          <label for="password" class="block text-sm font-medium" style="color: var(--text-body)">Contraseña</label>
            <input id="password" name="password" type="password" required class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Tu contraseña" />
          </div>
        </div>
        <div class="flex items-center justify-between">
          <label class="flex items-center gap-2 text-sm" style="color: var(--text-body)">
            <input id="remember-me" name="remember-me" type="checkbox" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" />
            Recordarme
          </label>
          <a href="#" class="text-sm font-semibold" style="color: var(--brand-accent)">¿Olvidaste tu contraseña?</a>
        </div>
        <button type="submit" class="w-full inline-flex justify-center items-center gap-2 py-2.5 px-4 text-sm font-semibold rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
          <svg class="h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" /></svg>
          Iniciar sesión
        </button>
      </form>
    </div>
  </div>
</div>
