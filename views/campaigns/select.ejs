<section class="theme-a365-light">
  <div class="max-w-[88%] mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <%- include('../partials/page-header', { title: 'Campañas', subtitle: 'Selecciona una campaña para continuar', extraContent: `<div class=\"flex items-center gap-2\"><button id=\"campaignThemeToggle\" class=\"px-3 py-2 rounded-md btn-secondary inline-flex items-center\"><span id=\"campaignThemeIcon\" class=\"h-5 w-5\"></span></button><a href=\"/auth/logout\" class=\"px-3 py-2 rounded-md btn-secondary inline-flex items-center gap-2\" aria-label=\"Salir\"><svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15.75 9V5.25A2.25 2.25 0 0013.5 3h-7.5A2.25 2.25 0 003.75 5.25v13.5A2.25 2.25 0 006 21h7.5a2.25 2.25 0 002.25-2.25V15\"/><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 9l3-3m0 0l-3-3m3 3H7.5\"/></svg><span>Salir</span></a></div>` }) %>


    <div class="max-w-2xl mx-auto mb-8">
      <div class="relative">
        <input type="text" id="searchInput" placeholder="Buscar campaña por nombre..." class="w-full px-4 py-2 rounded-lg border focus:outline-none focus:ring-2" />
        <svg class="absolute right-4 top-1/2 -translate-y-1/2 h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </div>
    </div>

    <div id="campaignsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% campaigns.forEach(campaign => { %>
      <div class="campaign-card bg-white rounded-xl shadow border overflow-hidden" data-nombre="<%= campaign.nombre.toLowerCase() %>">
        <div class="h-40 bg-[var(--brand-primary)]"></div>
        <div class="p-6">
          <h3 class="text-xl font-bold mb-2"><%= campaign.nombre %></h3>
          <p class="text-sm mb-4"><%= campaign.descripcion || 'Sin descripción' %></p>
          <div class="space-y-2 mb-6">
            <div class="flex items-center gap-2 text-sm">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              <span><strong>Gerente:</strong> <%= campaign.gerente || 'No asignado' %></span>
            </div>
            <div class="flex items-center gap-2 text-sm">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              <span><strong>Subcampañas:</strong> <%= campaign.subCampanas.length %></span>
            </div>
          </div>
          <div class="flex gap-2">
            <a href="/campaigns/select/<%= campaign._id %>" class="flex-1 btn-secondary px-3 py-2 rounded-md text-center">Acceder</a>
            <% if (user.role === 'admin') { %>
            <a href="/campaigns/edit/<%= campaign._id %>" class="btn-secondary px-3 py-2 rounded-md">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            </a>
            <button onclick="confirmDelete('<%= campaign._id %>', '<%= campaign.nombre %>')" class="btn-secondary px-3 py-2 rounded-md">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
            <% } %>
          </div>
        </div>
      </div>
      <% }); %>
    </div>

    <% if (campaigns.length === 0) { %>
    <div class="text-center py-20">
      <svg class="h-24 w-24 text-gray-400 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
      </svg>
      <h3 class="text-2xl font-bold mb-2 empty-state-title">No hay campañas disponibles</h3>
      <p class="text-gray-600">Selecciona o crea una campaña para continuar</p>
      <% if (user.role === 'admin') { %>
      <div class="mt-6">
        <button onclick="openCreateModal()" class="inline-flex items-center gap-2 btn-secondary px-3 py-2 rounded-md shadow transition">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
          Nueva Campaña
        </button>
      </div>
      <% } %>
    </div>
    <% } %>
  </div>

  <% if (user.role === 'admin') { %>
  <div id="createModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <div class="header-brand px-8 py-6 rounded-t-2xl">
        <h2 class="text-3xl font-bold text-white">Crear Nueva Campaña</h2>
      </div>
      <form method="POST" action="/campaigns/create" class="p-8 space-y-6">
        <div>
          <label class="block text-sm font-bold mb-2">Nombre de la Campaña *</label>
          <input type="text" name="nombre" required class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:outline-none">
        </div>
        <div>
          <label class="block text-sm font-bold mb-2">Descripción</label>
          <textarea name="descripcion" rows="3" class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:outline-none"></textarea>
        </div>
        <div>
          <label class="block text-sm font-bold mb-2">URL de Imagen</label>
          <input type="text" name="imagen" placeholder="/images/campana1.jpg" class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:outline-none">
          <p class="text-sm text-gray-500 mt-1">Deja vacío para usar imagen por defecto</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-bold mb-2">Gerente</label>
            <input type="text" name="gerente" class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:outline-none">
          </div>
          <div>
            <label class="block text-sm font-bold mb-2">Analista</label>
            <input type="text" name="analista" class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:outline-none">
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-bold mb-2">Color Primario</label>
            <input type="color" name="colorPrimary" value="#162B3D" class="w-full h-12 p-2 border rounded-lg">
          </div>
          <div>
            <label class="block text-sm font-bold mb-2">Color Acento</label>
            <input type="color" name="colorAccent" value="#2D4A66" class="w-full h-12 p-2 border rounded-lg">
          </div>
        </div>
        <div class="flex gap-4 pt-4">
          <button type="submit" class="flex-1 btn-primary font-semibold py-3 px-6 rounded-xl transition shadow">Crear Campaña</button>
          <button type="button" onclick="closeCreateModal()" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-3 px-6 rounded-xl transition">Cancelar</button>
        </div>
      </form>
    </div>
  </div>
  <% } %>

  <div id="deleteModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full">
      <div class="bg-red-600 modal-danger-header px-8 py-6 rounded-t-2xl">
        <h2 class="text-2xl font-bold text-white">Confirmar Eliminación</h2>
      </div>

      <div class="p-8">
        <p class="text-gray-700 mb-6">¿Estás seguro de que deseas eliminar la campaña <strong id="deleteCampaignName"></strong>?</p>
        <p class="text-sm text-red-600 mb-6">Esta acción no se puede deshacer.</p>

        <div class="flex gap-4">
          <form id="deleteForm" method="POST" action="" class="flex-1">
            <button type="submit" class="w-full btn-primary font-bold py-3 px-6 rounded-xl transition shadow-lg">
              Eliminar
            </button>
          </form>
          <button type="button" onclick="closeDeleteModal()" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold py-3 px-6 rounded-xl transition">
            Cancelar
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function(){
      var btn = document.getElementById('campaignThemeToggle');
      var icon = document.getElementById('campaignThemeIcon');
      if (btn && icon) {
        var sunIcon = '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m8-9h1M3 12H2m15.364 6.364l.707.707M5.929 5.929l-.707-.707m12.142 0l.707-.707M5.929 18.071l-.707.707M12 5a7 7 0 107 7 7.001 7.001 0 00-7-7z"/></svg>';
        var moonIcon = '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
        var isDarkInitial = document.documentElement.classList.contains('dark');
        icon.innerHTML = isDarkInitial ? sunIcon : moonIcon;
        function toContrastText(bg) {
          var m = bg.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
          if (!m) return 'var(--text-on-primary)';
          var r = parseInt(m[1],10), g = parseInt(m[2],10), b = parseInt(m[3],10);
          function srgb(v){ v/=255; return v<=0.03928? v/12.92 : Math.pow((v+0.055)/1.055,2.4); }
          var Y = 0.2126*srgb(r)+0.7152*srgb(g)+0.0722*srgb(b);
          return Y > 0.5 ? '#000000' : '#ffffff';
        }
        function applyContrast(){
          document.querySelectorAll('.theme-a365-light .btn-secondary, .theme-a365-light .btn-primary').forEach(function(el){
            var cs = getComputedStyle(el);
            var bg = cs.backgroundColor;
            el.style.color = toContrastText(bg);
          });
        }
        applyContrast();
        btn.addEventListener('click', function(){
          var isDark = document.documentElement.classList.toggle('dark');
          icon.innerHTML = isDark ? sunIcon : moonIcon;
          try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch(e){}
          applyContrast();
        });
      }
    })();
    const searchInput = document.getElementById('searchInput');
    const campaignCards = document.querySelectorAll('.campaign-card');
    searchInput.addEventListener('input', function() {
      const term = this.value.toLowerCase().trim();
      campaignCards.forEach(card => {
        const nombre = card.getAttribute('data-nombre');
        card.style.display = nombre.includes(term) ? '' : 'none';
      });
    });

    function openCreateModal() {
      document.getElementById('createModal').classList.remove('hidden');
      var nav = document.querySelector('.navbar-main');
      if (nav) { nav.style.display = 'none'; }
      var modules = document.getElementById('modules-navbar');
      if (modules) { modules.style.display = 'none'; }
      var mobile = document.querySelector('nav.fixed.bottom-0');
      if (mobile) { mobile.style.display = 'none'; }
      var footer = document.querySelector('footer');
      if (footer) { footer.style.display = 'none'; }
    }

    function closeCreateModal() {
      document.getElementById('createModal').classList.add('hidden');
      var nav = document.querySelector('.navbar-main');
      if (nav) { nav.style.display = ''; }
      var modules = document.getElementById('modules-navbar');
      if (modules) { modules.style.display = ''; }
      var mobile = document.querySelector('nav.fixed.bottom-0');
      if (mobile) { mobile.style.display = ''; }
      var footer = document.querySelector('footer');
      if (footer) { footer.style.display = ''; }
    }

    function confirmDelete(campaignId, campaignName) {
      document.getElementById('deleteCampaignName').textContent = campaignName;
      document.getElementById('deleteForm').action = '/campaigns/delete/' + campaignId;
      document.getElementById('deleteModal').classList.remove('hidden');
    }

    function closeDeleteModal() {
      document.getElementById('deleteModal').classList.add('hidden');
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeCreateModal();
        closeDeleteModal();
      }
    });
  </script>
</section>
