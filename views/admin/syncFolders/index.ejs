<!-- Header -->
<div class="bg-white border-b border-gray-200 mb-6">
  <div class="px-6 py-5">
    <h1 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-1">Carpetas Sincronizadas</h1>
    <p class="text-sm text-gray-600">Sincronización automática de datasets desde Google Drive y SharePoint</p>
  </div>
</div>

<!-- Botón Nueva Carpeta -->
<div class="mb-6">
  <a href="/admin/sync-folders/new" class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-md shadow-sm transition-colors">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
    </svg>
    Nueva Carpeta
  </a>
</div>

<% if (folders && folders.length > 0) { %>
<!-- Lista de Carpetas -->
<div class="space-y-6">
  <% folders.forEach(folder => { %>
  <div class="bg-white shadow rounded-lg overflow-hidden border border-gray-200">
    <!-- Header de la Carpeta -->
    <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <!-- Icono según tipo -->
        <% if (folder.tipo === 'google-drive') { %>
        <svg class="h-6 w-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.945 1.379l-.652.763c.023-.02.04-.05.064-.071l.588-.692zm-.584.688l-.597.702 7.261 12.574 1.253-1.468L12.4 2.129l-.04-.062zm.597-.031l-.652.763c.023-.02.04-.05.064-.071l.588-.692zM.789 8.352l7.262 12.572.652-.762L1.44 7.59l-.65.762zM8.789 20.25l7.261-12.574-.652-.762-7.261 12.574.652.762z"/>
        </svg>
        <% } else { %>
        <svg class="h-6 w-6 text-purple-600" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.625 0h-17.25C1.507 0 0 1.507 0 3.375v17.25C0 22.493 1.507 24 3.375 24h17.25C22.493 24 24 22.493 24 20.625V3.375C24 1.507 22.493 0 20.625 0zm-6.141 13.477c0 1.056-.872 1.911-1.953 1.911H6.516c-.457 0-.828-.372-.828-.828V9.375c0-.457.371-.828.828-.828h6.015c1.081 0 1.953.855 1.953 1.91v3.02z"/>
        </svg>
        <% } %>

        <div>
          <h3 class="text-lg font-semibold text-gray-900"><%= folder.nombre %></h3>
          <p class="text-sm text-gray-500">
            <%= folder.tipo === 'google-drive' ? 'Google Drive' : 'SharePoint' %>
            <% if (folder.config.folderId) { %>
              · ID: <%= folder.config.folderId.substring(0, 20) %>...
            <% } else if (folder.config.folderPath) { %>
              · <%= folder.config.folderPath %>
            <% } %>
          </p>
        </div>
      </div>

      <!-- Estado -->
      <div class="flex items-center gap-3">
        <% if (folder.syncConfig.autoSync && folder.syncStatus.activo) { %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
          <span class="w-2 h-2 mr-1.5 bg-green-600 rounded-full"></span>
          Activo
        </span>
        <% } else if (folder.syncConfig.autoSync && !folder.syncStatus.activo) { %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
          <span class="w-2 h-2 mr-1.5 bg-yellow-600 rounded-full"></span>
          Pausado
        </span>
        <% } else { %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
          <span class="w-2 h-2 mr-1.5 bg-gray-600 rounded-full"></span>
          Manual
        </span>
        <% } %>
      </div>
    </div>

    <!-- Estadísticas y Configuración -->
    <div class="px-6 py-4 grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Estadísticas -->
      <div>
        <h4 class="text-sm font-medium text-gray-700 mb-3">Estadísticas</h4>
        <div class="grid grid-cols-3 gap-4">
          <div class="text-center">
            <div class="text-2xl font-bold text-blue-600"><%= folder.syncStatus.archivosEncontrados || 0 %></div>
            <div class="text-xs text-gray-500">Encontrados</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-green-600"><%= folder.syncStatus.archivosProcesados || 0 %></div>
            <div class="text-xs text-gray-500">Procesados</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-red-600"><%= folder.syncStatus.archivosError || 0 %></div>
            <div class="text-xs text-gray-500">Errores</div>
          </div>
        </div>

        <!-- Última Sync -->
        <div class="mt-4 text-sm">
          <div class="flex items-center text-gray-600">
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Última sync:
            <% if (folder.syncStatus.ultimaSync) { %>
              <span class="ml-1 font-medium text-gray-900"><%= new Date(folder.syncStatus.ultimaSync).toLocaleString() %></span>
            <% } else { %>
              <span class="ml-1 text-gray-500">Nunca</span>
            <% } %>
          </div>

          <% if (folder.syncConfig.autoSync && folder.syncStatus.proximaSync) { %>
          <div class="flex items-center text-gray-600 mt-1">
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            Próxima sync:
            <span class="ml-1 font-medium text-gray-900"><%= new Date(folder.syncStatus.proximaSync).toLocaleString() %></span>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Configuración -->
      <div>
        <h4 class="text-sm font-medium text-gray-700 mb-3">Configuración</h4>
        <div class="space-y-2 text-sm">
          <div class="flex items-center justify-between">
            <span class="text-gray-600">Frecuencia:</span>
            <span class="font-medium text-gray-900">
              Cada <%= folder.syncConfig.frequencyMinutes || 30 %> minutos
            </span>
          </div>

          <div class="flex items-center justify-between">
            <span class="text-gray-600">Detección automática:</span>
            <% if (folder.syncConfig.autoDetect) { %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
              ✓ Sí
            </span>
            <% } else { %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
              Tipo fijo: <%= folder.syncConfig.fixedType %>
            </span>
            <% } %>
          </div>

          <div class="flex items-center justify-between">
            <span class="text-gray-600">Solo nuevos:</span>
            <span class="font-medium text-gray-900">
              <%= folder.syncConfig.processOnlyNew ? 'Sí' : 'No' %>
            </span>
          </div>

          <div class="flex items-center justify-between">
            <span class="text-gray-600">Después de procesar:</span>
            <span class="font-medium text-gray-900">
              <% if (folder.syncConfig.deleteAfterProcess) { %>
                Eliminar
              <% } else if (folder.syncConfig.moveAfterProcess) { %>
                Mover
              <% } else { %>
                Mantener
              <% } %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Archivos Recientes -->
    <% if (folder.processedFiles && folder.processedFiles.length > 0) { %>
    <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
      <h4 class="text-sm font-medium text-gray-700 mb-3">Archivos Recientes</h4>
      <div class="space-y-2">
        <% folder.processedFiles.slice(0, 3).forEach(file => { %>
        <div class="flex items-center justify-between text-sm">
          <div class="flex items-center gap-2 flex-1 min-w-0">
            <% if (file.status === 'success') { %>
            <svg class="h-4 w-4 text-green-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <% } else { %>
            <svg class="h-4 w-4 text-red-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
            </svg>
            <% } %>
            <span class="text-gray-900 truncate"><%= file.filename %></span>
            <% if (file.detectedType) { %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-800">
              <%= file.detectedType %>
            </span>
            <% } %>
          </div>
          <span class="text-gray-500 text-xs ml-2 flex-shrink-0">
            <%= new Date(file.processedAt).toLocaleString() %>
          </span>
        </div>
        <% }) %>
      </div>
      <% if (folder.processedFiles.length > 3) { %>
      <button onclick="verHistorial('<%= folder._id %>')" class="mt-2 text-xs text-blue-600 hover:text-blue-700 font-medium">
        Ver todos (<%= folder.processedFiles.length %>)
      </button>
      <% } %>
    </div>
    <% } %>

    <!-- Acciones -->
    <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <!-- Sincronizar Ahora -->
        <form method="POST" action="/admin/sync-folders/<%= folder._id %>/sync" class="inline">
          <button type="submit" class="inline-flex items-center px-3 py-1.5 border border-blue-300 text-sm font-medium rounded text-blue-700 bg-white hover:bg-blue-50 transition-colors">
            <svg class="h-4 w-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Sincronizar
          </button>
        </form>

        <!-- Activar/Desactivar -->
        <form method="POST" action="/admin/sync-folders/<%= folder._id %>/toggle" class="inline">
          <button type="submit" class="inline-flex items-center px-3 py-1.5 border border-gray-300 text-sm font-medium rounded text-gray-700 bg-white hover:bg-gray-50 transition-colors">
            <% if (folder.syncStatus.activo) { %>
            <svg class="h-4 w-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Pausar
            <% } else { %>
            <svg class="h-4 w-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Activar
            <% } %>
          </button>
        </form>

        <!-- Editar -->
        <a href="/admin/sync-folders/<%= folder._id %>/edit" class="inline-flex items-center px-3 py-1.5 border border-gray-300 text-sm font-medium rounded text-gray-700 bg-white hover:bg-gray-50 transition-colors">
          <svg class="h-4 w-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Editar
        </a>
      </div>

      <!-- Eliminar -->
      <button onclick="confirmarEliminacion('<%= folder._id %>', '<%= folder.nombre %>')" class="inline-flex items-center px-3 py-1.5 border border-red-300 text-sm font-medium rounded text-red-700 bg-white hover:bg-red-50 transition-colors">
        <svg class="h-4 w-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        Eliminar
      </button>
    </div>
  </div>
  <% }) %>
</div>

<% } else { %>
<!-- Estado Vacío -->
<div class="bg-white shadow rounded-lg p-12 text-center">
  <svg class="mx-auto h-16 w-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
  </svg>
  <h3 class="mt-4 text-lg font-medium text-gray-900">No hay carpetas sincronizadas</h3>
  <p class="mt-2 text-sm text-gray-500">
    Comienza configurando una carpeta de Google Drive o SharePoint para sincronización automática.
  </p>
  <div class="mt-6">
    <a href="/admin/sync-folders/new" class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-md shadow-sm transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Crear Primera Carpeta
    </a>
  </div>

  <!-- Info Box -->
  <div class="mt-8 max-w-2xl mx-auto bg-blue-50 border border-blue-200 rounded-lg p-4 text-left">
    <div class="flex items-start">
      <svg class="h-5 w-5 text-blue-600 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
      </svg>
      <div>
        <h4 class="text-sm font-medium text-blue-900">¿Qué es la sincronización automática?</h4>
        <p class="mt-1 text-sm text-blue-700">
          Configura carpetas de Google Drive o SharePoint para que tus datasets se carguen automáticamente.
          El sistema detectará el tipo de archivo por sus cabeceras y lo procesará sin intervención manual.
        </p>
        <a href="<%= process.env.AUTO_SYNC_README_URL || '#' %>" class="mt-2 inline-block text-sm font-medium text-blue-600 hover:text-blue-700">
          Leer documentación completa →
        </a>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Modal de Confirmación de Eliminación -->
<div id="modalEliminar" class="hidden fixed z-50 inset-0 overflow-y-auto">
  <div class="flex items-center justify-center min-h-screen px-4">
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>

    <div class="relative bg-white rounded-lg shadow-xl max-w-lg w-full p-6">
      <div class="sm:flex sm:items-start">
        <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
          <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
        </div>
        <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
          <h3 class="text-lg leading-6 font-medium text-gray-900">Eliminar carpeta sincronizada</h3>
          <div class="mt-2">
            <p class="text-sm text-gray-500">
              ¿Estás seguro de eliminar la carpeta <strong id="nombreCarpetaEliminar"></strong>?
              Esta acción no se puede deshacer. El historial de archivos procesados se perderá.
            </p>
          </div>
        </div>
      </div>
      <div class="mt-5 sm:mt-4 sm:flex sm:flex-row-reverse gap-2">
        <form id="formEliminar" method="POST" class="inline">
          <button type="submit" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-red-600 text-base font-medium text-white hover:bg-red-700 focus:outline-none sm:ml-3 sm:w-auto sm:text-sm">
            Eliminar
          </button>
        </form>
        <button type="button" onclick="cerrarModal()" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none sm:mt-0 sm:w-auto sm:text-sm">
          Cancelar
        </button>
      </div>
    </div>
  </div>
</div>

<script>
function confirmarEliminacion(id, nombre) {
  document.getElementById('nombreCarpetaEliminar').textContent = nombre;
  document.getElementById('formEliminar').action = '/admin/sync-folders/' + id + '/delete';
  document.getElementById('modalEliminar').classList.remove('hidden');
}

function cerrarModal() {
  document.getElementById('modalEliminar').classList.add('hidden');
}

function verHistorial(folderId) {
  // TODO: Implementar modal o página de historial completo
  alert('Historial completo de archivos para carpeta: ' + folderId);
}
</script>
