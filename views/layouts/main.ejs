<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - A365 Analytics</title>
    <link rel="icon" type="image/x-icon" href="/images/icon.ico" />
    <link href="/css/styles.css?v=camp-2" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
      try {
        var t = localStorage.getItem('theme');
        if (!t) {
          var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (prefersDark) t = 'dark';
        }
        if (t === 'dark') { document.documentElement.classList.add('dark'); }
      } catch (e) {}
    </script>
    <style>
      :root {
        --brand-primary: <%= (theme && theme.primary) || '#162B3D' %>;
        --brand-accent: <%= (theme && theme.accent) || '#2D4A66' %>;
        --text-on-primary: <%= (theme && theme.textOnPrimary) || '#ffffff' %>;
        --surface-bg: #f8fafc;
        --surface-card: #ffffff;
        --text: #374151;
        --muted: #6b7280;
        --border: #e5e7eb;
        --gray-50: #f9fafb;
        --gray-100: #f3f4f6;
        --gray-200: #e5e7eb;
        --gray-300: #d1d5db;
        --gray-400: #9ca3af;
        --gray-500: #6b7280;
        --gray-600: #4b5563;
        --gray-700: #374151;
        --gray-800: #1f2937;
        --gray-900: #111827;
        --overlay-scrim: rgba(0,0,0,0.16);
        --text-title: #1f2937;
        --text-body: #374151;
      }
      .dark {
        --surface-bg: #0f172a;
        --surface-card: #111827;
        --text: #e5e7eb;
        --muted: #cbd5e1;
        --border: #1f2937;
        --gray-50: #0b1220;
        --gray-100: #0b1628;
        --gray-200: #0e1b31;
        --gray-300: #13223d;
        --gray-400: #1b2b4a;
        --gray-500: #2a3a5c;
        --gray-600: #344366;
        --gray-700: #cbd5e1;
        --gray-800: #e5e7eb;
        --gray-900: #f1f5f9;
        --overlay-scrim: rgba(0,0,0,0.5);
        --text-title: #dbe1ea;
        --text-body: #cfd6e4;
      }
      html { font-size: 15px; }
      body { font-family: 'Public Sans', system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif; color: var(--text-body); background-color: var(--surface-bg) !important; transition: background-color .2s ease, color .2s ease, border-color .2s ease; }
      h1, h2, h3 { font-weight: 600; letter-spacing: 0.2px; }
      h1 { font-size: 2rem; line-height: 1.25; }
      h2 { font-size: 1.5rem; line-height: 1.3; }
      h3 { font-size: 1.25rem; line-height: 1.3; }
      h4 { font-size: 1.125rem; line-height: 1.3; }
      .btn-primary { background-color: var(--brand-accent); color: var(--text-on-primary); }
      .header-brand { background-color: var(--brand-primary); color: var(--text-on-primary); }
      .header-brand h1,
      .header-brand h2,
      .header-brand h3,
      .header-brand h4 { color: var(--text-on-primary) !important; }
      .fade-enter { opacity: 0; transform: translateX(-6px); }
      .fade-enter-active { opacity: 1; transform: translateX(0); transition: opacity .18s ease, transform .18s ease; }
      .fade-leave { opacity: 1; transform: translateX(0); }
      .fade-leave-active { opacity: 0; transform: translateX(-6px); transition: opacity .16s ease, transform .16s ease; }
      html:not(.dark) h1,
      html:not(.dark) h2,
      html:not(.dark) h3,
      html:not(.dark) h4 { color: var(--brand-primary) !important; }
      .dark h1,
      .dark h2,
      .dark h3,
      .dark h4 { color: var(--text-title) !important; }
      a { color: var(--text); }
      a:hover { color: var(--text); text-decoration: underline; text-decoration-color: var(--brand-accent); }
      :root { --shadow-sm: 0 1px 2px rgba(17, 24, 39, 0.06); --shadow-md: 0 6px 12px rgba(17, 24, 39, 0.08); --shadow-lg: 0 10px 22px rgba(17, 24, 39, 0.12); }
      :root { --radius-sm: 0.375rem; --radius-md: 0.5rem; --radius-lg: 0.75rem; }
      .btn { border-radius: var(--radius-md); padding: 0.5rem 0.75rem; font-weight: 600; }
      /* Navbar neutro */
      #modules-navbar { border-color: var(--border); }
      #modules-navbar .nav-link { border-color: var(--border); transition: background-color .16s ease, color .16s ease; border-left: 3px solid transparent; }
      #modules-navbar .nav-link:hover { color: #374151; background-color: #f9fafb; }
      .nav-link-active { background-color: #f3f4f6; color: #111827; border-color: #d1d5db; border-left-color: var(--brand-accent); }

      /* Tarjetas sobrias: unificamos bloques con sombra/rounded hacia fondo blanco y borde gris */
      .rounded-xl.shadow-lg,
      .rounded-lg.shadow-lg,
      .rounded-xl.shadow,
      .rounded-lg.shadow { box-shadow: var(--shadow-sm) !important; border: 1px solid var(--border) !important; background: var(--surface-card) !important; transition: box-shadow .18s ease, transform .18s ease; }
      .rounded-xl, .rounded-lg { border-radius: var(--radius-lg) !important; }
      /* Neutralizar gradientes en tarjetas */
      .rounded-xl.bg-gradient-to-br,
      .rounded-lg.bg-gradient-to-br,
      .shadow-lg.bg-gradient-to-br,
      .shadow.bg-gradient-to-br {
        background: var(--surface-card) !important;
        border: 1px solid var(--border) !important;
      }
      /* Neutralizar variantes de color en tarjetas con sombra para estilo sobrio */
      .shadow-lg.bg-yellow-50,
      .shadow-lg.bg-teal-50,
      .shadow-lg.bg-blue-50,
      .shadow-lg.bg-red-50,
      .shadow-lg.bg-purple-50,
      .shadow-lg.bg-green-50,
      .shadow.bg-yellow-50,
      .shadow.bg-teal-50,
      .shadow.bg-blue-50,
      .shadow.bg-red-50,
      .shadow.bg-purple-50,
      .shadow.bg-green-50 {
        background: var(--surface-card) !important;
        border: 1px solid var(--border) !important;
      }
      /* Títulos dentro de tarjetas sobrias con color de campaña */
      html:not(.dark) .rounded-xl.shadow-lg dt,
      html:not(.dark) .rounded-lg.shadow-lg dt,
      html:not(.dark) .rounded-xl.shadow dt,
      html:not(.dark) .rounded-lg.shadow dt { color: var(--brand-primary) !important; }
      .dark .rounded-xl.shadow-lg dt,
      .dark .rounded-lg.shadow-lg dt,
      .dark .rounded-xl.shadow dt,
      .dark .rounded-lg.shadow dt { color: var(--text) !important; }
      html:not(.dark) .rounded-xl.shadow-lg dd,
      html:not(.dark) .rounded-lg.shadow-lg dd,
      html:not(.dark) .rounded-xl.shadow dd,
      html:not(.dark) .rounded-lg.shadow dd { color: var(--text) !important; }
      .dark .rounded-xl.shadow-lg dd,
      .dark .rounded-lg.shadow-lg dd,
      .dark .rounded-xl.shadow dd,
      .dark .rounded-lg.shadow dd { color: var(--text) !important; }

      /* Tablas sobrias globales */
      table thead { background-color: var(--gray-50) !important; border-bottom: 1px solid var(--border) !important; }
      table thead th { color: var(--text-title) !important; font-weight: 600 !important; }
      table tbody tr:nth-child(even) { background-color: var(--gray-50) !important; }
      table tbody tr:hover { background-color: var(--gray-100) !important; }
      table td { color: var(--text-body) !important; }
      table tbody td, table thead th { padding: 0.75rem 1rem !important; }

      input[type="text"], input[type="email"], input[type="password"], input[type="number"], input[type="search"], input[type="tel"], input[type="url"], input[type="date"], input[type="time"], input[type="datetime-local"], select, textarea { transition: box-shadow .14s ease, border-color .14s ease, background-color .14s ease, color .14s ease; background-color: var(--surface-card); color: var(--text); border-color: var(--border); }
      input[type="text"]::placeholder, input[type="email"]::placeholder, input[type="password"]::placeholder, input[type="number"]::placeholder, input[type="search"]::placeholder, input[type="tel"]::placeholder, input[type="url"]::placeholder, textarea::placeholder { color: var(--muted); }
      label { color: var(--text-body); }
      input[type="text"]:focus, input[type="email"]:focus, input[type="password"]:focus, input[type="number"]:focus, input[type="search"]:focus, input[type="tel"]:focus, input[type="url"]:focus, input[type="date"]:focus, input[type="time"]:focus, input[type="datetime-local"]:focus, select:focus, textarea:focus { border-color: var(--brand-accent) !important; box-shadow: 0 0 0 3px rgba(45, 74, 102, 0.15); }
      select option, select optgroup { background-color: var(--surface-card); color: var(--text); }
      input[type="checkbox"], input[type="radio"], input[type="range"] { accent-color: var(--brand-accent); }
      input[type="checkbox"], input[type="radio"] { background-color: var(--surface-card); border-color: var(--border); }
      input[type="checkbox"]:focus, input[type="radio"]:focus { outline: 2px solid var(--brand-accent); outline-offset: 2px; }
      input[disabled], select[disabled], textarea[disabled] { opacity: 0.7; color: var(--muted); border-color: var(--border); background-color: var(--surface-card); }
      input[type="file"] { color: var(--text); }
      input[type="file"]::file-selector-button { background-color: var(--brand-accent); color: var(--text-on-primary); border: none; border-radius: var(--radius-md); padding: 0.375rem 0.75rem; }
      input[type="file"]::file-selector-button:hover { filter: brightness(0.95); }
      button, .btn-primary, a.btn-primary { transition: box-shadow .14s ease, transform .14s ease, filter .14s ease; }
      button:hover, .btn-primary:hover, a.btn-primary:hover { box-shadow: 0 8px 16px rgba(17, 24, 39, 0.12); transform: translateY(-1px); filter: brightness(0.97); }
      button:active, .btn-primary:active, a.btn-primary:active { transform: translateY(0); filter: brightness(0.95); }
      .form-control { border-radius: var(--radius-md); }

      /* Iconos dentro de tarjetas a tono sobrio */
      .rounded-xl.shadow-lg .flex-shrink-0,
      .rounded-lg.shadow-lg .flex-shrink-0,
      .rounded-xl.shadow .flex-shrink-0,
      .rounded-lg.shadow .flex-shrink-0 {
        background-color: #f3f4f6 !important;
        color: var(--brand-primary) !important;
      }

      /* Sistema de iconos unificado */
      svg.icon { width: 1rem; height: 1rem; display: inline-block; }
      svg.icon-sm { width: 0.875rem; height: 0.875rem; }
      svg.icon-lg { width: 1.25rem; height: 1.25rem; }
      svg.icon-xl { width: 2rem; height: 2rem; }
      .icon-neutral { color: #6b7280; }
      .icon-primary { color: var(--brand-primary); }
      .icon-accent { color: var(--brand-accent); }
      svg.icon path, svg.icon circle, svg.icon rect, svg.icon line, svg.icon polyline { stroke-width: 2; }
      #page-header .flex-shrink-0 svg { width: 1rem; height: 1rem; }
      #modules-navbar .nav-link svg { width: 1rem; height: 1rem; }
      #modules-navbar .nav-link svg path { stroke-width: 2; }

      /* Encabezado de página a tono de tema */
      #page-header { background-color: var(--surface-card) !important; border-bottom: 1px solid var(--border) !important; }
      html:not(.dark) #page-header h1 { color: var(--brand-primary) !important; }
      .dark #page-header h1 { color: var(--text-title) !important; }
      #page-header p { color: var(--muted) !important; }

      /* Encabezados comunes (filtros, paneles, gráficos) */
      .section-header,
      .panel-header,
      .filters-header,
      .chart-header,
      .widget-header,
      .widget-card-header {
        background-color: var(--gray-50) !important;
        border-bottom: 1px solid var(--border) !important;
        color: var(--text) !important;
      }
      html:not(.dark) .section-header h2,
      html:not(.dark) .panel-header h2,
      html:not(.dark) .filters-header h2,
      html:not(.dark) .chart-header h2,
      html:not(.dark) .widget-card-title { color: var(--brand-primary) !important; }
      .dark .section-header h2,
      .dark .panel-header h2,
      .dark .filters-header h2,
      .dark .chart-header h2,
      .dark .widget-card-title { color: var(--text-title) !important; }
      .section-header p,
      .panel-header p,
      .filters-header p,
      .chart-header p { color: var(--muted) !important; }
      .widget-toolbar button { color: var(--muted) !important; }
      .dark .section-header,
      .dark .panel-header,
      .dark .filters-header,
      .dark .chart-header,
      .dark .widget-header,
      .dark .widget-card-header { background-color: var(--gray-100) !important; }

      /* Neutralizar gradientes en encabezados para sobriedad y tema */
      .bg-gradient-to-r { background: var(--surface-card) !important; color: var(--text) !important; }

      /* Banner de campaña: texto usa color de campaña solo en modo claro */
      html:not(.dark) #campaign-banner { color: var(--brand-primary) !important; }
      .dark #campaign-banner { color: var(--text) !important; }
      html:not(.dark) #campaign-banner .accent { border-left-color: var(--brand-accent) !important; }

      .bg-white.rounded-lg,
      .bg-white.rounded-xl { box-shadow: var(--shadow-sm); border: 1px solid var(--border); transition: box-shadow .18s ease, transform .18s ease; background: var(--surface-card); }
      .bg-white.rounded-lg:hover,
      .bg-white.rounded-xl:hover { box-shadow: var(--shadow-lg); transform: translateY(-1px); }

      .bg-white { background: var(--surface-card) !important; }
      .bg-gray-50 { background: var(--gray-50) !important; }

      html:not(.dark) .theme-a365-light {
        --brand-primary: #2c5494;
        --brand-accent: #c40c0c;
        --text-title: #2c5494;
        --text-body: #747474;
      }

      .theme-a365-light #page-header {
        background-image: linear-gradient(135deg, var(--brand-primary), var(--brand-accent));
        color: var(--text-on-primary) !important;
        border-bottom: none !important;
      }
      .theme-a365-light #page-header h1,
      .theme-a365-light #page-header p { color: var(--text-on-primary) !important; }
      .theme-a365-light #page-header .flex-shrink-0 * { color: var(--text-on-primary) !important; }

      html:not(.dark) .theme-a365-light,
      html:not(.dark) .theme-a365-light p,
      html:not(.dark) .theme-a365-light span,
      html:not(.dark) .theme-a365-light li,
      html:not(.dark) .theme-a365-light dd,
      html:not(.dark) .theme-a365-light dt,
      html:not(.dark) .theme-a365-light label,
      html:not(.dark) .theme-a365-light input,
      html:not(.dark) .theme-a365-light select,
      html:not(.dark) .theme-a365-light textarea {
        color: var(--text-body) !important;
      }
      html:not(.dark) .theme-a365-light h1,
      html:not(.dark) .theme-a365-light h2,
      html:not(.dark) .theme-a365-light h3,
      html:not(.dark) .theme-a365-light h4 {
        color: var(--text-title) !important;
      }
      html:not(.dark) .theme-a365-light .text-gray-500,
      html:not(.dark) .theme-a365-light .text-gray-600,
      html:not(.dark) .theme-a365-light .text-gray-700 {
        color: var(--text-body) !important;
      }
      html:not(.dark) .theme-a365-light .text-gray-900 {
        color: var(--text-title) !important;
      }
      html:not(.dark) .theme-a365-light .header-brand {
        color: var(--text-on-primary) !important;
      }

      .badge { display: inline-block; padding: 0.25rem 0.5rem; border-radius: 9999px; font-weight: 600; font-size: 0.75rem; }
      .badge-primary { background-color: var(--brand-accent); color: var(--text-on-primary); }
      .badge-neutral { background-color: var(--gray-100); color: var(--text); }
      footer { background-color: var(--surface-card) !important; border-top: 1px solid var(--border); }
      .chip { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.25rem 0.5rem; border-radius: 9999px; border: 1px solid var(--border); background-color: var(--surface-card); font-size: 0.75rem; color: var(--text); }
      .theme-a365-light .empty-state-title { color: var(--brand-accent) !important; }
      .chip svg { width: 0.875rem; height: 0.875rem; }

      button.bg-blue-600,
      a.bg-blue-600,
      button.bg-indigo-600,
      a.bg-indigo-600,
      button.bg-purple-600,
      a.bg-purple-600,
      button.bg-teal-600,
      a.bg-teal-600,
      button.bg-green-600,
      a.bg-green-600,
      .btn-primary {
        background-color: var(--brand-accent) !important;
        color: var(--text-on-primary) !important;
        border-color: transparent !important;
      }
      .btn-secondary,
      a.btn-secondary {
        background-color: var(--brand-accent) !important;
        color: var(--text-on-primary) !important;
        border-color: transparent !important;
      }
      .modal-danger-header h1,
      .modal-danger-header h2,
      .modal-danger-header h3,
      .modal-danger-header h4 { color: var(--text-on-primary) !important; }
      .btn-primary:hover {
        background-color: var(--brand-accent) !important;
        color: var(--text-on-primary) !important;
        border-color: transparent !important;
        filter: brightness(0.94);
        box-shadow: 0 8px 16px rgba(17, 24, 39, 0.12);
        transform: translateY(-1px);
      }
      .btn-secondary:hover {
        background-color: var(--brand-accent) !important;
        filter: brightness(0.94);
        box-shadow: 0 8px 16px rgba(17, 24, 39, 0.12);
        transform: translateY(-1px);
      }
      button.bg-gray-600:hover,
      a.bg-gray-600:hover { 
        filter: brightness(0.95);
        box-shadow: 0 8px 16px rgba(17, 24, 39, 0.12);
        transform: translateY(-1px);
      }
      button[class*="from-indigo-"][class*="to-indigo-"],
      a[class*="from-indigo-"][class*="to-indigo-"],
      button[class*="from-purple-"][class*="to-purple-"],
      a[class*="from-purple-"][class*="to-purple-"] {
        background-color: var(--brand-accent) !important;
        color: var(--text-on-primary) !important;
        border-color: transparent !important;
        background-image: none !important;
      }
      button[class*="from-indigo-"][class*="to-indigo-"]:hover,
      a[class*="from-indigo-"][class*="to-indigo-"]:hover,
      button[class*="from-purple-"][class*="to-purple-"]:hover,
      a[class*="from-purple-"][class*="to-purple-"]:hover {
        background-color: var(--brand-accent) !important;
        filter: brightness(0.95);
      }

      .dark .navbar-main { background-color: #0b1220 !important; color: #ffffff !important; border-bottom-color: #1f2937 !important; }
      .dark .navbar-main a { color: #e5e7eb !important; }
      .dark .navbar-main a:hover { color: #ffffff !important; }
    </style>
</head>
<body class="bg-gray-50 pb-16 lg:pb-0">
    <!-- Navigation -->
    <% if (typeof hideNavbar === 'undefined' || !hideNavbar) { %>
    <nav class="text-white shadow-lg navbar-main" style="background-color: var(--brand-primary); color: var(--text-on-primary); backdrop-filter: saturate(160%) blur(6px); border-bottom: 1px solid var(--border); transition: background-color .2s ease, color .2s ease, border-color .2s ease;">
        <div class="max-w-[88%] mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 sm:h-20">
                <div class="flex">
                    <div class="flex-shrink-0 flex items-center">
                        <a href="/" class="inline-flex items-center group">
                            <img src="/images/logo.png" alt="Logo" class="my-2 sm:my-3 h-12 sm:h-14 w-auto object-contain filter invert brightness-0 drop-shadow transition duration-100 ease-out group-hover:invert-0 group-hover:brightness-105 group-hover:saturate-85 cursor-pointer" />
                        </a>
                    </div>
                    <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
                        <a href="/" class="border-transparent text-white hover:text-gray-200 inline-flex items-center px-1 pt-1 border-b-0 text-sm font-bold">Inicio</a>
                        <a href="/about" class="border-transparent text-white hover:text-gray-200 inline-flex items-center px-1 pt-1 border-b-0 text-sm font-bold">Acerca de</a>
                    </div>
                </div>
                <div class="hidden sm:ml-6 sm:flex sm:items-center">
                    <% if (user) { %>
                        <div class="relative ml-3">
                            <div class="flex items-center">
                                <span class="mr-2 text-sm font-medium">Bienvenido, <%= user.username %></span>
                                <a href="/auth/logout" class="text-white font-semibold py-2 px-4 rounded" style="background-color: var(--brand-accent)">
                                    Cerrar sesión
                                </a>
                                <button id="themeToggle" class="ml-2 text-white font-semibold py-2 px-3 rounded" style="background-color: var(--brand-accent)">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m8-9h1M3 12H2m15.364 6.364l.707.707M5.929 5.929l-.707-.707m12.142 0l.707-.707M5.929 18.071l-.707.707M12 5a7 7 0 107 7 7.001 7.001 0 00-7-7z"/></svg>
                                </button>
                            </div>
                        </div>
                    <% } %>
                    <% if (!user) { %>
                        <a href="/auth/login" class="text-white font-semibold py-2 px-4 rounded" style="background-color: var(--brand-accent)">
                            Iniciar sesión
                        </a>
                        <a href="/auth/register" class="ml-4 text-white font-semibold py-2 px-4 rounded" style="background-color: var(--brand-accent)">
                            Registrarse
                        </a>
                        <button id="themeToggle" class="ml-2 text-white font-semibold py-2 px-3 rounded" style="background-color: var(--brand-accent)">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m8-9h1M3 12H2m15.364 6.364l.707.707M5.929 5.929l-.707-.707m12.142 0l.707-.707M5.929 18.071l-.707.707M12 5a7 7 0 107 7 7.001 7.001 0 00-7-7z"/></svg>
                        </button>
                    <% } %>
                </div>
                <!-- Mobile menu button -->
                <div class="-mr-2 flex items-center sm:hidden">
                    <button type="button" class="inline-flex items-center justify-center p-2 rounded-md text-white hover:text-gray-300 focus:outline-none" id="mobile-menu">
                        <span class="sr-only">Abrir menú principal</span>
                        <svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Menú móvil simple -->
        <div id="mobile-menu-modal" class="fixed inset-0 z-50 hidden sm:hidden" role="dialog" aria-modal="true" aria-labelledby="mobile-menu-title">
          <div id="mobile-menu-overlay" class="absolute inset-0 bg-black bg-opacity-50"></div>
          <div class="absolute inset-x-0 bottom-0 rounded-t-2xl bg-white shadow-xl max-h-[85vh] overflow-y-auto">
            <div class="px-4 pt-4 pb-2 flex items-center justify-between border-b">
              <h2 id="mobile-menu-title" class="text-base font-semibold text-gray-800">Menú</h2>
              <button id="mobile-menu-close" class="p-2 text-gray-500 hover:text-gray-700" aria-label="Cerrar menú">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-5 w-5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M6 18L18 6"/></svg>
              </button>
            </div>
            <div class="p-4 space-y-1">
              <a href="/" class="block px-3 py-3 rounded-md text-base font-medium text-gray-800 hover:bg-gray-100">Inicio</a>
              <a href="/about" class="block px-3 py-3 rounded-md text-base font-medium text-gray-800 hover:bg-gray-100">Acerca de</a>
              <% if (user) { %>
                <a href="/dashboard" class="block px-3 py-3 rounded-md text-base font-medium text-gray-800 hover:bg-gray-100">Tablero Principal</a>
                <a href="/custom-dashboard" class="block px-3 py-3 rounded-md text-base font-medium text-gray-800 hover:bg-gray-100">Dashboards Personalizados</a>
                <a href="/powerbi" class="block px-3 py-3 rounded-md text-base font-medium text-gray-800 hover:bg-gray-100">Power BI</a>
                <a href="/srr" class="block px-3 py-3 rounded-md text-base font-medium text-gray-800 hover:bg-gray-100">SRR</a>
                <a href="/kpis" class="block px-3 py-3 rounded-md text-base font-medium text-gray-800 hover:bg-gray-100">KPIs</a>
                <a href="/asesores" class="block px-3 py-3 rounded-md text-base font-medium text-gray-800 hover:bg-gray-100">Asesores</a>
                <a href="/asistencia" class="block px-3 py-3 rounded-md text-base font-medium text-gray-800 hover:bg-gray-100">Asistencia</a>
                <% if (user.role === 'admin') { %>
                  <a href="/admin" class="block px-3 py-3 rounded-md text-base font-medium text-gray-800 hover:bg-gray-100">Administración</a>
                <% } %>
                <div class="pt-2 mt-2 border-t">
                  <div class="px-3 text-sm text-gray-500">Sesión</div>
                  <a href="/auth/logout" class="block mt-1 px-3 py-3 rounded-md text-base font-medium text-gray-800 hover:bg-gray-100">Cerrar sesión</a>
                </div>
              <% } else { %>
                <div class="pt-2 mt-2 border-t">
                  <a href="/auth/login" class="block px-3 py-3 rounded-md text-base font-medium text-gray-800 hover:bg-gray-100">Iniciar sesión</a>
                  <a href="/auth/register" class="block px-3 py-3 rounded-md text-base font-medium text-gray-800 hover:bg-gray-100">Registrarse</a>
                </div>
              <% } %>
            </div>
          </div>
        </div>
    </nav>
    <% } %>

    <!-- Flash Messages -->
    <% if (Array.isArray(success_msg) && success_msg.length) { %>
        <div class="max-w-[88%] mx-auto px-4 sm:px-6 lg:px-8 mt-3">
            <% success_msg.forEach(function(msg){ %>
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-2 rounded relative mb-2" role="alert">
                    <span class="block sm:inline"><%= msg %></span>
                </div>
            <% }) %>
        </div>
    <% } %>

    <% if ((Array.isArray(error_msg) && error_msg.length) || (Array.isArray(error) && error.length)) { %>
        <div class="max-w-[88%] mx-auto px-4 sm:px-6 lg:px-8 mt-3">
            <% (error_msg || []).concat(error || []).forEach(function(msg){ %>
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-2 rounded relative mb-2" role="alert">
                    <span class="block sm:inline"><%= msg %></span>
                </div>
            <% }) %>
        </div>
    <% } %>

    <!-- Contenedor principal con barra lateral (solo si hay usuario) -->
    <% if (user) { %>
      <div class="max-w-[88%] mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex flex-col gap-4">
          <!-- Navbar de módulos (horizontal) -->
          <% if (typeof hideNavbar === 'undefined' || !hideNavbar) { %>
          <nav id="modules-navbar" class="bg-white border rounded-lg px-3 py-2 overflow-x-auto">
            <ul class="flex items-center gap-2 flex-wrap">
              <li>
                <a href="/dashboard" class="nav-link inline-flex items-center gap-2 px-3 py-2 text-sm rounded-md border text-gray-700 hover:bg-gray-50">
                  <svg class="icon icon-neutral" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/></svg>
                  Tablero
                </a>
              </li>
              <li>
                <a href="/custom-dashboard" class="nav-link inline-flex items-center gap-2 px-3 py-2 text-sm rounded-md border text-gray-700 hover:bg-gray-50">
                  <svg class="icon icon-neutral" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  Personalizados
                </a>
              </li>
              <li>
                <a href="/powerbi" class="nav-link inline-flex items-center gap-2 px-3 py-2 text-sm rounded-md border text-gray-700 hover:bg-gray-50">
                  <svg class="icon icon-neutral" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
                  Power BI
                </a>
              </li>
              <li>
                <a href="/srr" class="nav-link inline-flex items-center gap-2 px-3 py-2 text-sm rounded-md border text-gray-700 hover:bg-gray-50">
                  <svg class="icon icon-neutral" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                  SRR
                </a>
              </li>
              <li>
                <a href="/kpis" class="nav-link inline-flex items-center gap-2 px-3 py-2 text-sm rounded-md border text-gray-700 hover:bg-gray-50">
                  <svg class="icon icon-neutral" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10"/></svg>
                  KPIs
                </a>
              </li>
              <li>
                <a href="/asesores" class="nav-link inline-flex items-center gap-2 px-3 py-2 text-sm rounded-md border text-gray-700 hover:bg-gray-50">
                  <svg class="icon icon-neutral" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7a4 4 0 11-8 0 4 4 0 018 0zM15 21H3v-1a6 6 0 0112 0v1z"/></svg>
                  Asesores
                </a>
              </li>
              <li>
                <a href="/asistencia" class="nav-link inline-flex items-center gap-2 px-3 py-2 text-sm rounded-md border text-gray-700 hover:bg-gray-50">
                  <svg class="icon icon-neutral" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3M4 11h16M4 19h16"/></svg>
                  Asistencia
                </a>
              </li>
              <% if (user && user.role === 'admin') { %>
              <li>
                <a href="/admin" class="nav-link inline-flex items-center gap-2 px-3 py-2 text-sm rounded-md border text-gray-700 hover:bg-gray-50">
                  <svg class="icon icon-neutral" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6"/></svg>
                  Admin
                </a>
              </li>
              <% } %>
            </ul>
          </nav>
          <% } %>

          <!-- Contenido principal -->
          <main id="main-content" class="flex-1 min-w-0 transition-all duration-300 ease-in-out relative z-0">
            <!-- Breadcrumb de Campaña -->
            <% if ((typeof hideNavbar === 'undefined' || !hideNavbar) && typeof selectedCampaign !== 'undefined' && selectedCampaign) { %>
            <div id="campaign-banner" class="rounded-lg shadow mb-6 px-6 py-4" style="backdrop-filter: saturate(160%) blur(6px); border: 1px solid var(--border); transition: background-color .2s ease, color .2s ease, border-color .2s ease;">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3 accent">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                  <span class="text-xl font-bold" style="color: var(--text)">A365</span>
                  <svg class="h-5 w-5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  <span class="text-lg font-semibold" style="opacity: 0.85; color: var(--text)">Campaña: <%= (tenant && tenant.nombre) || '—' %></span>
                </div>
                <a 
                  href="/campaigns" 
                  class="inline-flex items-center px-4 py-2 font-semibold rounded-lg"
                  style="background-color: var(--brand-accent); color: var(--text-on-primary)"
                >
                  <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                  </svg>
                  Cambiar Campaña
                </a>
              </div>
            </div>
            <% } %>
            
            <%- body %>
          </main>
        </div>
      </div>
    <% } else { %>
      <!-- Sin usuario: contenido centrado sin barra lateral -->
      <main class="max-w-[88%] mx-auto px-4 sm:px-6 lg:px-8 py-6">
          <%- body %>
      </main>
    <% } %>

    <!-- Footer -->
    <% if (typeof hideNavbar === 'undefined' || !hideNavbar) { %>
    <footer class="bg-white mt-12">
        <div class="max-w-[88%] mx-auto py-6 px-4 sm:px-6 lg:px-8">
            <p class="text-center text-gray-500 text-sm">
                &copy; <%= new Date().getFullYear() %> A365 - Análisis de Datos. Todos los derechos reservados.
                · <a href="https://www.a365.com.pe" target="_blank" rel="noopener" class="underline hover:text-gray-700">Sitio A365</a>
            </p>
        </div>
    </footer>
    <% } %>
    <script>
      (function(){
        var btn=document.getElementById('themeToggle');
        if(!btn) return;
        btn.addEventListener('click',function(){
          var el=document.documentElement;
          var isDark=el.classList.toggle('dark');
          try{localStorage.setItem('theme', isDark?'dark':'light');}catch(e){}
        });
      })();
    </script>

    <!-- Barra inferior móvil -->
    <% if (typeof hideNavbar === 'undefined' || !hideNavbar) { %>
    <nav class="fixed bottom-0 inset-x-0 bg-white border-t shadow-sm lg:hidden z-40">
      <ul class="grid grid-cols-4 gap-0 text-xs text-gray-600">
        <li>
          <a href="/" class="flex flex-col items-center justify-center py-2 hover:bg-gray-50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l9-9 9 9M4.5 10.5V21h15V10.5"/></svg>
            <span>Inicio</span>
          </a>
        </li>
        <% if (user) { %>
        <li>
          <a href="/dashboard" class="flex flex-col items-center justify-center py-2 hover:bg-gray-50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h7v7H3V3zm11 0h7v7h-7V3zM3 14h7v7H3v-7zm11 0h7v7h-7v-7z"/></svg>
            <span>Tablero</span>
          </a>
        </li>
        <li>
          <a href="/powerbi" class="flex flex-col items-center justify-center py-2 hover:bg-gray-50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/></svg>
            <span>Dashbords</span>
          </a>
        </li>
        <li>
          <a href="/srr" class="flex flex-col items-center justify-center py-2 hover:bg-gray-50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
            <span>SRR</span>
          </a>
        </li>
        <% if (user.role === 'admin') { %>
        <li>
          <a href="/admin" class="flex flex-col items-center justify-center py-2 hover:bg-gray-50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v12m6-6H6"/></svg>
            <span>Admin</span>
          </a>
        </li>
        <% } else { %>
        <li>
          <a href="/auth/logout" class="flex flex-col items-center justify-center py-2 hover:bg-gray-50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-7.5A2.25 2.25 0 003.75 5.25v13.5A2.25 2.25 0 006 21h7.5a2.25 2.25 0 002.25-2.25V15M12 9l3-3m0 0l-3-3m3 3H7.5"/></svg>
            <span>Salir</span>
          </a>
        </li>
        <% } %>
        <% } else { %>
        <li>
          <a href="/auth/login" class="flex flex-col items-center justify-center py-2 hover:bg-gray-50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 11.25v-6m0 0l-3 3m3-3l3 3M6.75 12a5.25 5.25 0 1010.5 0 5.25 5.25 0 00-10.5 0z"/></svg>
            <span>Entrar</span>
          </a>
        </li>
        <li>
          <a href="/auth/register" class="flex flex-col items-center justify-center py-2 hover:bg-gray-50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v12m6-6H6"/></svg>
            <span>Registro</span>
          </a>
        </li>
        <% } %>
      </ul>
    </nav>
    <% } %>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/campaigns.js"></script>
    <script src="/js/dashboard.js"></script>
</body>
</html>
