<section class="theme-a365-light">
  <div class="max-w-[88%] mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <%- include('../partials/page-header', { title: 'Gestión de Campañas', subtitle: 'Administra campañas, roles y subcampañas', extraContent: `<div class=\"flex items-center gap-2\"><button id=\"campaignThemeToggle\" class=\"px-3 py-2 rounded-md btn-secondary inline-flex items-center\"><span id=\"campaignThemeIcon\" class=\"h-5 w-5\"></span></button><a href=\"/auth/logout\" class=\"px-3 py-2 rounded-md btn-secondary inline-flex items-center gap-2\" aria-label=\"Salir\"><svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15.75 9V5.25A2.25 2.25 0 0013.5 3h-7.5A2.25 2.25 0 003.75 5.25v13.5A2.25 2.25 0 006 21h7.5a2.25 2.25 0 002.25-2.25V15\"/><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 9l3-3m0 0l-3-3m3 3H7.5\"/></svg><span>Salir</span></a></div>` }) %>

    <div class="bg-white rounded-lg shadow p-6 mb-6">
      <div class="flex flex-col lg:flex-row gap-4 items-center justify-between">
        <div class="flex-1 w-full lg:max-w-2xl">
          <div class="relative">
            <input type="text" id="searchCampaign" placeholder="Buscar campaña por nombre..." class="w-full pl-12 pr-4 py-3 border rounded-lg focus:outline-none text-lg">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>
        </div>
      </div>
    </div>

    <div id="campaignsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    <% if (campaigns && campaigns.length > 0) { %>
      <% campaigns.forEach(campaign => { %>
      <div class="campaign-card bg-white rounded-xl shadow border transition-all duration-300 overflow-hidden" data-name="<%= campaign.nombre.toLowerCase() %>">
        <div class="px-6 py-4 bg-[var(--brand-primary)] text-white">
          <h3 class="text-xl font-bold truncate"><%= campaign.nombre %></h3>
        </div>
        
        <div class="p-6">
          <p class="mb-4 h-20 overflow-hidden"><%= campaign.descripcion || 'Sin descripción' %></p>
          
          <div class="space-y-2 mb-4 text-sm">
            <div class="flex items-center">
              <svg class="h-4 w-4 mr-2 text-[var(--brand-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              <strong>Gerente:</strong>&nbsp;<%= campaign.gerente || 'No asignado' %>
            </div>
            <div class="flex items-center">
              <svg class="h-4 w-4 mr-2 text-[var(--brand-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              <strong>Analista:</strong>&nbsp;<%= campaign.analista || 'No asignado' %>
            </div>
            <div class="flex items-center text-xs">
              <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Actualizado: <%= new Date(campaign.fechaActualizacion).toLocaleDateString('es-PE') %>
            </div>
            <% if (campaign.subCampanas && campaign.subCampanas.length > 0) { %>
            <div class="flex items-center text-xs">
              <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
              </svg>
              <%= campaign.subCampanas.length %> subcampaña(s)
            </div>
            <% } %>
          </div>
          
          <div class="flex gap-2">
            <a href="/campaigns/select/<%= campaign._id %>" class="flex-1 inline-flex items-center justify-center btn-secondary px-3 py-2 rounded-md shadow transition-all">
              <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
              Ver Campaña
            </a>
            
            <% if (user.role === 'admin') { %>
            <a href="/campaigns/edit/<%= campaign._id %>" class="inline-flex items-center justify-center btn-secondary px-3 py-2 rounded-md shadow transition-all">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
              </svg>
            </a>
            <% } %>
          </div>
        </div>
      </div>
      <% }); %>
    <% } else { %>
      <div class="col-span-full text-center py-12">
        <svg class="mx-auto h-24 w-24 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
        </svg>
        <h3 class="text-xl font-semibold mb-2 empty-state-title">No hay campañas registradas</h3>
        <p class="text-gray-600">Selecciona o crea una campaña para continuar</p>
        <% if (user.role === 'admin') { %>
        <div class="mt-6">
          <button onclick="showCreateModal()" class="inline-flex items-center gap-2 btn-secondary px-3 py-2 rounded-md shadow transition">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Nueva Campaña
          </button>
        </div>
        <% } %>
      </div>
    <% } %>
  </div>

<!-- Modal Crear Campaña -->
<% if (user.role === 'admin') { %>
<div id="createModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
    <div class="header-brand px-6 py-4 rounded-t-xl">
      <h3 class="text-2xl font-bold text-white">Nueva Campaña</h3>
    </div>
    
    <form method="POST" action="/campaigns/create" class="p-6 space-y-4">
      <div>
        <label class="block text-sm font-bold mb-2">Nombre de la Campaña *</label>
        <input 
          type="text" 
          name="nombre" 
          required 
          class="w-full px-4 py-2 border rounded-lg focus:outline-none"
        >
      </div>
      
      <div>
        <label class="block text-sm font-bold mb-2">Descripción</label>
        <textarea 
          name="descripcion" 
          rows="3"
          class="w-full px-4 py-2 border rounded-lg focus:outline-none"
        ></textarea>
      </div>
      
      <div>
        <label class="block text-sm font-bold mb-2">Gerente</label>
        <input 
          type="text" 
          name="gerente" 
          class="w-full px-4 py-2 border rounded-lg focus:outline-none"
        >
      </div>
      
      <div>
        <label class="block text-sm font-bold mb-2">Analista</label>
        <input 
          type="text" 
          name="analista" 
          class="w-full px-4 py-2 border rounded-lg focus:outline-none"
        >
      </div>
      
      <div class="flex gap-3 pt-4">
        <button type="submit" class="flex-1 px-6 py-3 font-bold rounded-lg btn-primary">
          Crear Campaña
        </button>
        <button type="button" onclick="hideCreateModal()" class="px-6 py-3 font-bold rounded-lg bg-gray-600 text-white">
          Cancelar
        </button>
      </div>
    </form>
  </div>
</div>
<% } %>

  <script>
// Toggle modo claro/oscuro local en campañas
(function(){
  var btn = document.getElementById('campaignThemeToggle');
  var icon = document.getElementById('campaignThemeIcon');
  if (btn && icon) {
    var sunIcon = '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m8-9h1M3 12H2m15.364 6.364l.707.707M5.929 5.929l-.707-.707m12.142 0l.707-.707M5.929 18.071l-.707.707M12 5a7 7 0 107 7 7.001 7.001 0 00-7-7z"/></svg>';
    var moonIcon = '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
    var isDarkInitial = document.documentElement.classList.contains('dark');
    icon.innerHTML = isDarkInitial ? sunIcon : moonIcon;
    function toContrastText(bg) {
      var m = bg.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
      if (!m) return 'var(--text-on-primary)';
      var r = parseInt(m[1],10), g = parseInt(m[2],10), b = parseInt(m[3],10);
      function srgb(v){ v/=255; return v<=0.03928? v/12.92 : Math.pow((v+0.055)/1.055,2.4); }
      var Y = 0.2126*srgb(r)+0.7152*srgb(g)+0.0722*srgb(b);
      return Y > 0.5 ? '#000000' : '#ffffff';
    }
    function applyContrast(){
      document.querySelectorAll('.theme-a365-light .btn-secondary, .theme-a365-light .btn-primary').forEach(function(el){
        var cs = getComputedStyle(el);
        var bg = cs.backgroundColor;
        el.style.color = toContrastText(bg);
      });
    }
    applyContrast();
    btn.addEventListener('click', function(){
      var isDark = document.documentElement.classList.toggle('dark');
      icon.innerHTML = isDark ? sunIcon : moonIcon;
      try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch(e){}
      applyContrast();
    });
  }
})();
// Buscador en tiempo real
document.getElementById('searchCampaign').addEventListener('input', function(e) {
  const searchTerm = e.target.value.toLowerCase();
  const cards = document.querySelectorAll('.campaign-card');
  
  cards.forEach(card => {
    const name = card.getAttribute('data-name');
    if (name.includes(searchTerm)) {
      card.style.display = '';
    } else {
      card.style.display = 'none';
    }
  });
});

// Modal functions
function showCreateModal() {
  document.getElementById('createModal').classList.remove('hidden');
  var nav = document.querySelector('.navbar-main');
  if (nav) { nav.style.display = 'none'; }
  var modules = document.getElementById('modules-navbar');
  if (modules) { modules.style.display = 'none'; }
  var mobile = document.querySelector('nav.fixed.bottom-0');
  if (mobile) { mobile.style.display = 'none'; }
  var footer = document.querySelector('footer');
  if (footer) { footer.style.display = 'none'; }
}

function hideCreateModal() {
  document.getElementById('createModal').classList.add('hidden');
  var nav = document.querySelector('.navbar-main');
  if (nav) { nav.style.display = ''; }
  var modules = document.getElementById('modules-navbar');
  if (modules) { modules.style.display = ''; }
  var mobile = document.querySelector('nav.fixed.bottom-0');
  if (mobile) { mobile.style.display = ''; }
  var footer = document.querySelector('footer');
  if (footer) { footer.style.display = ''; }
}
  </script>
  </div>
</section>
